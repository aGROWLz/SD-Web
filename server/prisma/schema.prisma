// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum KeyType {
  PLATFORM
  USER_OWNED
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PublicAssetProviderStatus {
  PENDING
  ACTIVE
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  canGenerate  Boolean  @default(true) @map("can_generate")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  apiKeys    ApiKey[]
  tasks      Task[]
  usageLogs  UsageLog[]
  publicAssets PublicAsset[]

  @@map("users")
}

model ApiKey {
  id         String   @id @default(uuid())
  name       String
  keyValue   String   @map("key_value")
  type       KeyType
  ownerId    String?  @map("owner_id")
  isActive   Boolean  @default(true) @map("is_active")
  rateLimit  Int      @default(60) @map("rate_limit")
  createdAt  DateTime @default(now()) @map("created_at")

  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks      Task[]
  usageLogs  UsageLog[]

  @@index([ownerId])
  @@index([type, isActive])
  @@map("api_keys")
}

model Task {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  apiKeyId      String?     @map("api_key_id")
  relayStationId String?    @map("relay_station_id")
  status        TaskStatus  @default(PENDING)
  prompt        String
  params        Json?
  videoUrl      String?     @map("result_url")
  localPath     String?     @map("local_path")
  errorMessage  String?     @map("error_message")
  startedAt     DateTime?   @map("started_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey        ApiKey?     @relation(fields: [apiKeyId], references: [id])
  relayStation  RelayStation? @relation(fields: [relayStationId], references: [id])
  usageLogs     UsageLog[]

  @@index([userId, status])
  @@index([apiKeyId])
  @@index([relayStationId])
  @@index([createdAt])
  @@map("tasks")
}

model UsageLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  apiKeyId   String?  @map("api_key_id")
  relayStationId String? @map("relay_station_id")
  taskId     String   @map("task_id")
  cost       Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id])
  relayStation RelayStation? @relation(fields: [relayStationId], references: [id])
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([apiKeyId])
  @@index([relayStationId])
  @@map("usage_logs")
}

model RelayStation {
  id              String   @id @default(uuid())
  name            String
  baseUrl         String   @map("base_url")
  queryBaseUrl    String?  @map("query_base_url")
  appendApiV3     Boolean  @default(true) @map("append_api_v3")
  modelRedirects  Json?    @map("model_redirects")
  assetLibraryConfig Json?  @map("asset_library_config")
  assetLibraryId String? @map("asset_library_id")
  apiKeyEncrypted String   @map("api_key_encrypted")
  isActive        Boolean  @default(true) @map("is_active")
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tasks      Task[]
  usageLogs  UsageLog[]
  assetLibrary AssetLibrary? @relation(fields: [assetLibraryId], references: [id], onDelete: SetNull)

  @@index([isActive, isPrimary])
  @@map("relay_stations")
}

model AssetLibrary {
  id String @id @default(uuid())
  name String
  provider String
  config Json
  apiKeyEncrypted String @map("api_key_encrypted")
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  relayStations RelayStation[]
  @@map("asset_libraries")
}

model PublicAsset {
  id               String                    @id @default(uuid())
  ownerId          String                    @map("owner_id")
  filename         String
  contentType      String                    @map("content_type")
  bytes            Int
  contentHash      String                    @unique @map("content_hash")
  localPath        String                    @map("local_path")
    providerAssetId  String?                   @map("provider_asset_id")
    providerLibrary  String?                   @map("provider_library")
  providerStatus   PublicAssetProviderStatus @default(PENDING) @map("provider_status")
  providerUrl      String?                   @map("provider_url")
  providerError    String?                   @map("provider_error")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  owner            User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([createdAt])
  @@index([providerStatus])
  @@map("public_assets")
}

model StorageSetting {
  id            String   @id @default("default")
  workerUrl     String?  @map("worker_url")
  keyEncrypted  String?  @map("key_encrypted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("storage_settings")
}
